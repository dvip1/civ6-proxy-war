<?xml version="1.0" encoding="utf-8"?>
<Mod id="12A6877C-C7BB-4ABF-8512-6FFD16D990FD" version="1">
	<Properties>
		<Name>Deniable Proxy War</Name>
		<Teaser>Fund someone else's war without wearing the blame for it.</Teaser>
		<Description>Removes the warmongering/grievance penalties that the SPONSOR of a Third Party War agreement currently absorbs. Vanilla charges you full blame for a war you paid someone else to fight (and triple blame if they raze a city), which makes the agreement close to useless. This is the deliberately minimal, unbalanced first version: deniability is absolute and free. Requires Rise and Fall or Gathering Storm.</Description>
		<Authors>dvip</Authors>
		<CompatibleVersions>2.0</CompatibleVersions>
	</Properties>
	<ActionCriteria>
		<!-- DIPLOACTION_THIRD_PARTY_WAR is defined in Expansion1 data, so it only
		     exists in the R&F and GS rulesets. Don't touch vanilla games. -->
		<Criteria id="ExpansionRuleset" any="1">
			<RuleSetInUse>RULESET_EXPANSION_1,RULESET_EXPANSION_2</RuleSetInUse>
		</Criteria>
	</ActionCriteria>
	<InGameActions>
		<UpdateDatabase id="ProxyWar_Gameplay" criteria="ExpansionRuleset">
			<File>Data/ProxyWar.sql</File>
		</UpdateDatabase>
		<UpdateText id="ProxyWar_Text" criteria="ExpansionRuleset">
			<File>Text/en_US/ProxyWar_Text.xml</File>
		</UpdateText>
	</InGameActions>
	<Files>
		<File>Data/ProxyWar.sql</File>
		<File>Text/en_US/ProxyWar_Text.xml</File>
	</Files>
</Mod>
